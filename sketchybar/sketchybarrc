#!/usr/bin/env sh

CONFIG_DIR="${CONFIG_DIR:-$HOME/.config/sketchybar}"
. "$CONFIG_DIR/colors.sh"

FONT="MonoLisa Plus"
ICON_FONT="Hack Nerd Font"

sketchybar --bar \
  position=top \
  height=38 \
  blur_radius=0 \
  color="$BAR_COLOR" \
  border_width=1 \
  border_color="$BAR_BORDER_COLOR" \
  shadow=off \
  sticky=on \
  topmost=off \
  display=all \
  padding_left=14 \
  padding_right=14 \
  notch_width=188 \
  y_offset=0 \
  margin=0

sketchybar --default \
  icon.font="$ICON_FONT:Regular:15.0" \
  icon.color="$FOREGROUND" \
  label.font="$FONT:Medium:14.0" \
  label.color="$FOREGROUND" \
  padding_left=7 \
  padding_right=7 \
  background.corner_radius=4 \
  background.height=26

sketchybar --add event aerospace_workspace_change

# Small Omarchy-like logo/menu button.
sketchybar --add item apple left \
  --set apple \
    icon="" \
    icon.font="SF Pro:Semibold:18.0" \
    icon.color="$FOREGROUND" \
    label.drawing=off \
    padding_left=1 \
    padding_right=11 \
    click_script="open -a 'System Settings'"

# Minimal Omarchy workspaces: numbers for inactive spaces and a cream square
# for the focused space, matching the supplied reference.
for sid in 1 2 3 4 5 6 7 8 9; do
  sketchybar --add item "space.$sid" left \
    --subscribe "space.$sid" aerospace_workspace_change \
    --set "space.$sid" \
      icon="$sid" icon.font="$FONT:Medium:16.0" \
      icon.width=30 \
      icon.align=center \
      label.drawing=off \
      background.drawing=off \
      background.height=30 \
      background.corner_radius=4 \
      padding_left=2 \
      padding_right=2 \
      click_script="aerospace workspace $sid" \
      script="/bin/sh $CONFIG_DIR/plugins/aerospace.sh $sid"
done

# Focused app for the selected AeroSpace workspace.
sketchybar --add item front_app left \
  --set front_app \
    icon.font="$ICON_FONT:Regular:15.0" \
    icon.color="$ACCENT" \
    icon.padding_left=8 \
    icon.padding_right=8 \
    label.font="$FONT:Medium:13.0" \
    label.color="$FOREGROUND" \
    label.padding_left=0 \
    label.padding_right=9 \
    label.max_chars=22 \
    background.color="$ITEM_BG_COLOR" \
    background.drawing=on \
    background.corner_radius=7 \
    background.height=27 \
    padding_left=10 \
    padding_right=4 \
    script="/bin/sh $CONFIG_DIR/plugins/front_app.sh" \
  --subscribe front_app front_app_switched aerospace_workspace_change

# Omarchy-style centered date and time. On the external display this sits at
# the true center; SketchyBar automatically accounts for the internal notch.
sketchybar --add item mic center \
  --set mic icon="󰍭" icon.color="$ACCENT" label.drawing=off padding_right=8 \
    click_script="open 'x-apple.systempreferences:com.apple.Sound-Settings.extension'"

sketchybar --add item clock center \
  --set clock \
    icon.drawing=off \
    label.font="$FONT:Medium:13.0" \
    label.color="$FOREGROUND" \
    update_freq=30 \
    script="/bin/sh $CONFIG_DIR/plugins/clock.sh" \
    click_script="open -a Calendar"

sketchybar --add item moon center \
  --set moon icon="󰖔" icon.color="$FOREGROUND" label.drawing=off padding_left=8 \
    click_script="open 'x-apple.systempreferences:com.apple.Focus-Settings.extension'"

sketchybar --add item refresh center \
  --set refresh icon="󰑐" icon.color="$FOREGROUND" label.drawing=off \
    click_script="sketchybar --reload"

sketchybar --add item battery right \
  --set battery update_freq=120 script="/bin/sh $CONFIG_DIR/plugins/battery.sh" \
  --subscribe battery power_source_change system_woke

sketchybar --add item volume right \
  --set volume label.width=28 script="/bin/sh $CONFIG_DIR/plugins/volume.sh" \
  --subscribe volume volume_change \
  --set volume click_script="osascript -e 'set volume output muted not (output muted of (get volume settings))'"

sketchybar --add item wifi right \
  --set wifi update_freq=30 script="/bin/sh $CONFIG_DIR/plugins/wifi.sh" \
  --subscribe wifi wifi_change system_woke

sketchybar --add item bluetooth right \
  --set bluetooth icon="󰂯" icon.color="$FOREGROUND" label.drawing=off \
    click_script="open 'x-apple.systempreferences:com.apple.BluetoothSettings'"

sketchybar --add item display_icon right \
  --set display_icon icon="󰍹" icon.color="$FOREGROUND" label.drawing=off \
    click_script="open 'x-apple.systempreferences:com.apple.Displays-Settings.extension'"

sketchybar --add item chevron right \
  --set chevron icon="󰅁" icon.color="$FOREGROUND" label.drawing=off

# Now Playing sits at the left edge of the right status group. Polling is used
# because SketchyBar's media_change event is deprecated on macOS 26.
sketchybar --add item media right \
  --set media \
    icon.font="$ICON_FONT:Regular:15.0" \
    icon.color="$ACCENT" \
    icon.padding_left=8 \
    icon.padding_right=8 \
    label.font="$FONT:Medium:12.0" \
    label.color="$FOREGROUND" \
    label.padding_left=0 \
    label.padding_right=9 \
    label.max_chars=28 \
    background.color="$ITEM_BG_COLOR" \
    background.drawing=on \
    background.corner_radius=7 \
    background.height=27 \
    update_freq=3 \
    script="/bin/sh $CONFIG_DIR/plugins/media.sh" \
    click_script="nowplaying-cli togglePlayPause >/dev/null 2>&1; /bin/sh $CONFIG_DIR/plugins/media.sh"

sketchybar --update
