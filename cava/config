# Smooth Catppuccin Mocha spectrum with automatic platform audio detection.

[general]
framerate = 60
autosens = 1
sensitivity = 110
bars = 0
bar_width = 2
bar_spacing = 1
lower_cutoff_freq = 40
higher_cutoff_freq = 16000
sleep_timer = 5

[output]
method = noncurses
orientation = bottom
channels = stereo
mono_option = average
reverse = 0
show_idle_bar_heads = 1
waveform = 0

[color]
background = default
gradient = 1
gradient_color_1 = '#94e2d5'
gradient_color_2 = '#89dceb'
gradient_color_3 = '#74c7ec'
gradient_color_4 = '#89b4fa'
gradient_color_5 = '#b4befe'
gradient_color_6 = '#cba6f7'
gradient_color_7 = '#f5c2e7'
gradient_color_8 = '#f38ba8'

[smoothing]
noise_reduction = 72
monstercat = 1
waves = 0

[eq]
1 = 1.15
2 = 1.10
3 = 1.05
4 = 1.00
5 = 0.95
